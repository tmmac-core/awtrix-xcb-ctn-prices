# IP oder Hostname deines Ulanzi TC001 mit AWTRIX/SVITRIX.
TC001_HOST=192.168.1.50

# Optional: Name der Custom-App im AWTRIX-Loop.
AWTRIX_APP_NAME=xcb_ctn_prices

# Optional: Wechsel- und Refresh-Intervalle.
DISPLAY_ROTATION_SECONDS=10
PRICE_REFRESH_SECONDS=60
REQUEST_TIMEOUT_MS=8000

# Optional: Standard ist Ping Exchange.
PING_API_BASE=https://api.ping.exchange/marketdata/api/v1/tickers
PRICE_API_XCB=https://api.ping.exchange/marketdata/api/v1/tickers?symbol=xcb_usdc
PRICE_API_CTN=https://api.ping.exchange/marketdata/api/v1/tickers?symbol=ctn_usdc

# Optional: AWTRIX-Icon-ID, Icon-Dateiname ohne Extension oder 8x8-JPG als Base64.
# Ohne diese Werte nutzt der Dienst die mitgelieferten 8x8-Icons aus assets/.
# XCB_ICON=
# CTN_ICON=
